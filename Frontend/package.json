{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:report": "playwright show-report",
    "test:chatbot": "node --test src/chatbot/chatbot.test.js",
    "test:gst": "node --test src/utils/gst.test.js src/utils/invoiceForm.test.js",
    "test:accounts": "node --test src/utils/vouchers.test.js src/utils/accounting.test.js src/utils/gstReturns.test.js src/utils/inventory.test.js src/utils/payroll.test.js src/utils/einvoice.test.js",
    "test:units": "node --test \"src/utils/*.test.js\" src/chatbot/chatbot.test.js",
    "test:books": "playwright test tests/books-flows.spec.js --project=\"Google Chrome\""
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@nivo/pie": "^0.99.0",
    "@tailwindcss/vite": "^4.1.12",
    "axios": "^1.11.0",
    "firebase": "^12.3.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.2",
    "lenis": "^1.3.18",
    "lucide-react": "^0.542.0",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "read-excel-file": "^9.3.10",
    "simple-icons": "^16.34.0",
    "tailwindcss": "^4.1.13",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "baseline-browser-mapping": "^2.10.7",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  }
}
