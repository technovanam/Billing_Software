rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers: strict auth checks (never trust client — enforce server-side)
    // -------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isValidString(s, maxLen) {
      return s is string && s.size() <= maxLen;
    }

    // -------------------------------------------------------------------------
    // Admin Role-Based Access Control (RBAC) Helpers
    // -------------------------------------------------------------------------
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) ||
        request.auth.token.email == "admin@technovanam.com"
      );
    }

    function getAdminRole() {
      return exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        : (request.auth.token.email == "admin@technovanam.com" ? "Super Admin" : "None");
    }

    function isSuperAdmin() {
      return isAdmin() && getAdminRole() == "Super Admin";
    }

    function hasPermission(permissionName) {
      return isAdmin() && (
        getAdminRole() == "Super Admin" ||
        get(/databases/$(database)/documents/adminRoles/$(getAdminRole())).data.permissions.get(permissionName, false) == true
      );
    }

    // Warehouse: allows a linked reader (e.g., a warehouse operator) read access
    function isLinkedWarehouseReader(userId) {
      return isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // POS cashiers: signed in with a backend-issued custom token carrying
    // role, businessUid and cashierId claims. A session is valid only while the
    // cashier is active and was signed in after the last revocation
    // (PIN change, deactivation, device removal set validAfterSec).
    // -------------------------------------------------------------------------
    function isCashierOf(userId) {
      return isAuthenticated()
        && request.auth.token.get('role', '') == 'cashier'
        && request.auth.token.get('businessUid', '') == userId
        && cashierSessionValid(userId);
    }
    function cashierSessionValid(userId) {
      let secret = get(/databases/$(database)/documents/users/$(userId)/cashierSecrets/$(request.auth.token.cashierId)).data;
      return secret.get('active', true) != false
        && request.auth.token.auth_time > secret.get('validAfterSec', 0);
    }
    function isOwnCashierId() {
      return request.auth.token.get('cashierId', '');
    }
    function isPosBill(data) {
      return data.get('source', '') == 'POS Counter Terminal';
    }

    // -------------------------------------------------------------------------
    // Tenant Businesses and Subcollections
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Cashiers read the business profile (name, logo) for receipts.
      allow read: if isOwner(userId) || isAdmin() || isCashierOf(userId);
      
      // Profile write only with validated fields (no arbitrary client data)
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'companyName', 'ownerName', 'phone', 'gstin', 'address',
          'city', 'state', 'pincode', 'logoURL', 'createdAt'
        ])
        && isValidString(request.resource.data.get('companyName', ''), 200)
        && isValidString(request.resource.data.get('ownerName', ''), 200)
        && isValidString(request.resource.data.get('phone', ''), 20)
        && isValidString(request.resource.data.get('gstin', ''), 20)
        && isValidString(request.resource.data.get('address', ''), 500)
        && isValidString(request.resource.data.get('city', ''), 100)
        && isValidString(request.resource.data.get('state', ''), 100)
        && isValidString(request.resource.data.get('pincode', ''), 10)
        && isValidString(request.resource.data.get('logoURL', ''), 1000);
      
      allow update: if 
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'planName', 'subscriptionExpiry', 'totalSales', 'usersCount', 'branchesCount'])) 
        || hasPermission('Edit Business') 
        || hasPermission('Suspend Business') 
        || hasPermission('Activate Business') 
        || hasPermission('Extend Terms');
      allow delete: if hasPermission('Delete Business');

      // Subcollections: tenant owner or platform admin
      match /customers/{docId} {
        allow read: if isOwner(userId) || isAdmin() || isCashierOf(userId);
        allow create: if isOwner(userId) || isCashierOf(userId);
        allow update, delete: if isOwner(userId);
      }
      match /products/{docId} {
        allow read: if isOwner(userId) || isAdmin() || isCashierOf(userId);
        allow write: if isOwner(userId);
      }
      match /invoices/{docId} {
        // Cashiers see only POS bills and create them in their own name.
        allow read: if isOwner(userId) || isAdmin() || (isCashierOf(userId) && isPosBill(resource.data));
        allow create: if isOwner(userId)
          || (isCashierOf(userId) && isPosBill(request.resource.data) && request.resource.data.get('cashier', '') == isOwnCashierId());
        allow update, delete: if isOwner(userId);
      }
      match /payments/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /expenses/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /recurringInvoices/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      // Was readable by anyone (including plain-text cashier PINs); owner/admin only now.
      match /settings/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /deliveryChallans/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // Warehouse / Godown collections
      match /stock/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /stockMovements/{docId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;   // movements are immutable
      }
      match /damaged_stock/{docId} {
        allow read, write: if isOwner(userId) || isLinkedWarehouseReader(userId);
      }
      match /damagedStock/{docId} {
        allow read, write: if isOwner(userId) || isLinkedWarehouseReader(userId);
      }
      match /barcodeIndex/{barcode} {
        allow read: if isOwner(userId) || isLinkedWarehouseReader(userId);
        allow write: if isOwner(userId);
      }
      match /staff/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /cashiers/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /branches/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || hasPermission('Edit Business');
      }
      match /godowns/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || hasPermission('Edit Business');
      }
      match /terminals/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || hasPermission('Edit Business');
      }
      // AI command audit trail: written only by the backend (Admin SDK).
      match /aiLogs/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
      // AI learning statistics: built only by the backend (Admin SDK).
      match /aiStats/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // POS shifts: written only by the backend (one open shift per cashier
      // and per counter is enforced there). Cashiers read their own.
      match /posShifts/{shiftId} {
        allow read: if isOwner(userId) || isAdmin()
          || (isCashierOf(userId) && resource.data.cashierId == isOwnCashierId());
        allow write: if false;
      }
      match /posShiftLocks/{lockId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
      // PIN hashes and lockout state: backend only, never readable by clients.
      match /cashierSecrets/{cashierId} {
        allow read, write: if false;
      }
      // Login attempts and session revocations.
      match /securityLogs/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Super Admin Collections
    // -------------------------------------------------------------------------
    match /adminRoles/{roleId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }
    
    match /adminUsers/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }
    
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /loginActivity/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /activeSessions/{docId} {
      allow read, write: if isAdmin();
    }

    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read, write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /systemBackups/{docId} {
      allow read, write: if isAdmin();
    }

    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection Group Queries for Super Admin
    // -------------------------------------------------------------------------
    match /{path=**}/invoices/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/payments/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/customers/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/branches/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/godowns/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/terminals/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/cashiers/{docId} {
      allow read: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Default deny: no other collections or paths are accessible
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
