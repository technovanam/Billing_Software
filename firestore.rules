rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers: strict auth checks (never trust client — enforce server-side)
    // -------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isValidString(s, maxLen) {
      return s is string && s.size() <= maxLen;
    }

    // -------------------------------------------------------------------------
    // Admin Role-Based Access Control (RBAC) Helpers
    // -------------------------------------------------------------------------
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }
    
    function getAdminRole() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role;
    }
    
    function isSuperAdmin() {
      return isAdmin() && getAdminRole() == "Super Admin";
    }
    
    function hasPermission(permissionName) {
      return isAdmin() && (
        getAdminRole() == "Super Admin" || 
        get(/databases/$(database)/documents/adminRoles/$(getAdminRole())).data.permissions.get(permissionName, false) == true
      );
    }

    // -------------------------------------------------------------------------
    // User document: company profile (signup). Only owner; validate shape/size.
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || hasPermission('View Businesses');
      // Profile write only with validated fields (no arbitrary client data)
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'companyName', 'ownerName', 'phone', 'gstin', 'address',
          'city', 'state', 'pincode', 'logoURL', 'createdAt'
        ])
        && isValidString(request.resource.data.get('companyName', ''), 200)
        && isValidString(request.resource.data.get('ownerName', ''), 200)
        && isValidString(request.resource.data.get('phone', ''), 20)
        && isValidString(request.resource.data.get('gstin', ''), 20)
        && isValidString(request.resource.data.get('address', ''), 500)
        && isValidString(request.resource.data.get('city', ''), 100)
        && isValidString(request.resource.data.get('state', ''), 100)
        && isValidString(request.resource.data.get('pincode', ''), 10)
        && isValidString(request.resource.data.get('logoURL', ''), 1000);
      
      allow update: if 
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'planName', 'subscriptionExpiry', 'totalSales', 'usersCount', 'branchesCount'])) 
        || hasPermission('Edit Business') 
        || hasPermission('Suspend Business') 
        || hasPermission('Activate Business') 
        || hasPermission('Extend Terms');
      allow delete: if hasPermission('Delete Business');

      // Subcollections: strict path binding — only this user's data or platform admin
      match /customers/{docId} {
        allow read: if isOwner(userId) || hasPermission('View Analytics');
        allow write: if isOwner(userId);
      }
      match /products/{docId} {
        allow read: if isOwner(userId) || hasPermission('View Analytics');
        allow write: if isOwner(userId);
      }
      match /invoices/{docId} {
        allow read: if isOwner(userId) || hasPermission('View Analytics');
        allow write: if isOwner(userId);
      }
      match /payments/{docId} {
        allow read: if isOwner(userId) || hasPermission('View Payments');
        allow write: if isOwner(userId) || hasPermission('Process Refund');
      }
      match /expenses/{docId} {
        allow read: if isOwner(userId) || hasPermission('View Analytics');
        allow write: if isOwner(userId);
      }
      match /recurringInvoices/{docId} {
        allow read: if isOwner(userId) || hasPermission('View Analytics');
        allow write: if isOwner(userId);
      }
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /cashiers/{docId} {
        allow read: if isOwner(userId) || hasPermission('View Users');
        allow write: if isOwner(userId) || hasPermission('Suspend User') || hasPermission('Reset Password');
      }
      match /branches/{docId} {
        allow read: if isOwner(userId) || hasPermission('View Businesses');
        allow write: if isOwner(userId) || hasPermission('Edit Business');
      }
      match /godowns/{docId} {
        allow read: if isOwner(userId) || hasPermission('View Businesses');
        allow write: if isOwner(userId) || hasPermission('Edit Business');
      }
      match /terminals/{docId} {
        allow read: if isOwner(userId) || hasPermission('View Businesses');
        allow write: if isOwner(userId) || hasPermission('Edit Business');
      }
    }

    // -------------------------------------------------------------------------
    // Super Admin Collections
    // -------------------------------------------------------------------------
    match /adminRoles/{roleId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }
    
    match /adminUsers/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }
    
    match /auditLogs/{logId} {
      allow read: if hasPermission('View Analytics') || isSuperAdmin();
      allow create: if isAdmin(); // Anyone acting as admin can append logs
      allow update, delete: if false; // Logs are immutable
    }

    match /subscriptionPlans/{planId} {
      allow read: if true; // Public or any logged in user can view plans
      allow write: if hasPermission('Change Plan') || hasPermission('Cancel Plan');
    }

    match /supportTickets/{ticketId} {
      allow read: if hasPermission('View Settings') || isSuperAdmin();
      allow write: if hasPermission('View Settings') || isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Default deny: no other collections or paths are accessible
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
