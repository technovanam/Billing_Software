rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers: strict auth checks (never trust client — enforce server-side)
    // -------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isValidString(s, maxLen) {
      return s is string && s.size() <= maxLen;
    }
    // Allow a warehouse user to READ the admin's product catalog if they have a
    // settings/profile doc with linkedAdminUid == userId.
    function isLinkedWarehouseReader(userId) {
      return isAuthenticated()
        && request.auth.uid != userId
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/settings/profile)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/settings/profile).data.linkedAdminUid == userId;
    }

    // -------------------------------------------------------------------------
    // User document: company profile (signup). Only owner; validate shape/size.
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if true;
      // Profile write only with validated fields (no arbitrary client data)
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'companyName', 'ownerName', 'phone', 'gstin', 'address',
          'city', 'state', 'pincode', 'logoURL', 'createdAt'
        ])
        && isValidString(request.resource.data.get('companyName', ''), 200)
        && isValidString(request.resource.data.get('ownerName', ''), 200)
        && isValidString(request.resource.data.get('phone', ''), 20)
        && isValidString(request.resource.data.get('gstin', ''), 20)
        && isValidString(request.resource.data.get('address', ''), 500)
        && isValidString(request.resource.data.get('city', ''), 100)
        && isValidString(request.resource.data.get('state', ''), 100)
        && isValidString(request.resource.data.get('pincode', ''), 10)
        && isValidString(request.resource.data.get('logoURL', ''), 1000);
      allow delete: if false;

      // Subcollections: strict path binding — only this user's data
      match /customers/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /products/{docId} {
        allow read: if isOwner(userId) || isLinkedWarehouseReader(userId);
        allow write: if isOwner(userId);
      }
      match /invoices/{docId} {
        allow read: if true;
        allow write: if true;
      }
      match /payments/{docId} {
        allow read: if true;
        allow write: if true;
      }
      match /expenses/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /recurringInvoices/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /settings/{docId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
      match /deliveryChallans/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ── Warehouse / Godown collections ────────────────────────────────────

      // Godown definitions — owner can read/write freely
      match /godowns/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Current stock per product+godown — owner can read/write
      // Mutation operations (IN/OUT/transfer) use atomic Firestore client transactions.
      // Backend mutations go through Firebase Admin SDK which bypasses rules — this
      // rule covers direct client-side writes used in this implementation.
      match /stock/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Stock movements — append-only ledger.
      // Reads allowed, creates allowed, update & delete explicitly denied to protect
      // audit integrity. (Admin SDK on backend can still correct if needed.)
      match /stockMovements/{docId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;   // movements are immutable
      }

      // Damaged Stock — separated inventory tracking
      match /damaged_stock/{docId} {
        allow read, write: if isOwner(userId) || isLinkedWarehouseReader(userId);
      }
      match /damagedStock/{docId} {
        allow read, write: if isOwner(userId) || isLinkedWarehouseReader(userId);
      }

      // Barcode index — barcode IS the doc ID; uniqueness enforced via transaction.
      match /barcodeIndex/{barcode} {
        allow read: if isOwner(userId) || isLinkedWarehouseReader(userId);
        allow write: if isOwner(userId);
      }

      // Staff definitions — for operator picker
      match /staff/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Barcode cache — short-lived external API result cache (30-day TTL enforced in app).
      match /barcodeCache/{barcode} {
        allow read, write: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // Default deny: no other collections or paths are accessible
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
