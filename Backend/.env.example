# Copy to Backend/.env and fill in values. Never commit Backend/.env.

# --- Firebase Admin (required: the backend will not start without it) ---
# Either put the dev service account key at Backend/serviceAccountKey.json,
# or point to it here. See Backend/README.md "Getting credentials".
GOOGLE_APPLICATION_CREDENTIALS=

# --- AI command billing ---
# Local-first: commands are parsed on this server first. A model is only asked
# when the local parse scores below AI_LOCAL_CONFIDENCE (0-1, default 0.85).
AI_LOCAL_CONFIDENCE=
# Fallback when the local parser is unsure: none (default, fully local) or
# ollama (a model you host yourself). No third-party AI service is supported.
AI_FALLBACK=
# Ollama fallback (self-hosted, OpenAI-compatible API), e.g. http://gpu-box:11434
AI_OLLAMA_URL=
AI_OLLAMA_MODEL=
# Optional bearer token if your Ollama server sits behind an authenticating proxy.
AI_OLLAMA_API_KEY=
# Max AI requests per user per minute. Defaults to 20.
AI_RATE_LIMIT_PER_MIN=
# Minimum fuzzy-match confidence (0-1) for an automatic product/customer match. Defaults to 0.75.
AI_MATCH_THRESHOLD=
# Deprecated: AI_PROVIDER is no longer read. Use AI_FALLBACK.

# --- Existing settings ---
FIREBASE_PROJECT_ID=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
RECURRING_INVOICE_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Cloud Storage bucket for super admin database backups (e.g. your-project.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# ── E-invoice (IRN) through a GST Suvidha Provider ─────────────────────────
# 1. On https://einvoice1.gst.gov.in: API Registration -> User Credentials ->
#    Create API User -> "Through GSP" -> pick your GSP, set an API username/password.
# 2. Sign up with that GSP to get a client id/secret and their base URL.
# 3. Fill these in. EINVOICE_GSP selects the adapter in einvoice/gspClient.js
#    ("nic-passthrough" for GSPs that expose the NIC API unchanged).
EINVOICE_GSP=
EINVOICE_BASE_URL=
EINVOICE_CLIENT_ID=
EINVOICE_CLIENT_SECRET=
EINVOICE_GSTIN=
EINVOICE_USERNAME=
EINVOICE_PASSWORD=

# ── GST return upload (GSTR-1) through a GSP ───────────────────────────────
# Uses the taxpayer API: an OTP is sent to your GST-registered mobile for each
# session; the app saves GSTR-1 on the portal, you submit/file there with EVC.
# GSTR_GSP selects the adapter in gst/returnsClient.js ("gstn-passthrough").
GSTR_GSP=
GSTR_BASE_URL=
GSTR_CLIENT_ID=
GSTR_CLIENT_SECRET=
GSTR_GSTIN=
GSTR_USERNAME=
