# Copy to POS/backend/.env and fill in values. Never commit POS/backend/.env.

# Firebase Admin (required): put the service account key at
# POS/backend/serviceAccountKey.json, or point to it here.
GOOGLE_APPLICATION_CREDENTIALS=

# Port for this server (default 5100). The POS frontend reads VITE_POS_BACKEND_URL.
POS_PORT=

# Razorpay for counter UPI/card payments (online payments are off without them).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

