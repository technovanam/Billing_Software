{
  "name": "Techno Vanam POS",
  "short_name": "TV POS",
  "description": "Techno Vanam point-of-sale billing terminal",
  "id": "/pos",
  "start_url": "/pos",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#f1f5f9",
  "theme_color": "#2563eb",
  "icons": [
    { "src": "/pos-icons/pos-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pos-icons/pos-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pos-icons/pos-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/pos-icons/pos-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
